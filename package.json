{
  "name": "edgetts-ws-worker",
  "version": "2.22.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for Microsoft Edge TTS with an OpenAI-compatible API and a built-in web UI",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:fast && npm run test:e2e",
    "test:fast": "node --test --test-timeout=120000 \"test/unit/**/*.test.mjs\" \"test/integration/**/*.test.mjs\" \"test/regression/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/**/*.test.mjs\"",
    "test:regression": "node --test \"test/regression/**/*.test.mjs\"",
    "test:e2e": "node --test --test-timeout=120000 --test-concurrency=1 \"test/e2e/**/*.test.mjs\"",
    "coverage": "node --test --test-timeout=120000 --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.mjs\"",
    "check": "node --check src/worker.js && npm test",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev"
  },
  "license": "MIT"
}
